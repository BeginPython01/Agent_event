# Copy this file to .env and fill in real values. .env is git-ignored.

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Model used for extraction (cheap + fast is fine for this job)
CLAUDE_MODEL=claude-haiku-5-5

# User-Agent sent when fetching web pages. Add a contact URL so site owners know who we are.
SCRAPER_USER_AGENT=EventScoutBot/0.1 (student project)

# Database. SQLite file for local dev; a Postgres URL (Supabase) later.
DATABASE_URL=sqlite:///./scout.db
